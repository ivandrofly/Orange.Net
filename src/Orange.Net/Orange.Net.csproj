<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Orange.Net</PackageId>
    <Version>0.1.0</Version>
    <Description>.NET client for the Orange Developer APIs (https://developer.orange.com). Includes OAuth2 token handling and the SMS Middle East &amp; Africa API.</Description>
    <PackageTags>orange;sms;africa;oauth;api-client</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <InternalsVisibleTo Include="Orange.Net.Tests" />
  </ItemGroup>

</Project>
